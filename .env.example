# copy to .env and fill in; .env is git-ignored
ANNICT_TOKEN=

# all sources go through the proxy (api.bgm.tv is unreliable from mainland China too)
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1

# optional
# ANISTOCK_DB=/path/to/anistock.db   # default: data/anistock.db next to collect.py
# ANNICT_EXTRA_IDS=          # comma-separated Annict work ids for long-running shows (One Piece, Conan...)
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple   # if PyPI is slow

# ---- game server (systemd does not strip trailing comments, so keep comments on their own lines) ----
# random string that signs login cookies; generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
ANISTOCK_SECRET=
# invite code club members enter when registering
ANISTOCK_INVITE=
# the official QQ bot's add-friend link (settings and the forgot-password page link to it; hidden when empty)
ANISTOCK_QQ_BOT_URL=
# the operator's mailbox (forgot-password page, terms and privacy policy; hidden when empty)
ANISTOCK_CONTACT_EMAIL=
# where the game server listens; keep it on 127.0.0.1 and put a reverse proxy (Caddy / Nginx) in front
ANISTOCK_HOST=127.0.0.1
ANISTOCK_PORT=18620
# game database, default data/game.db
# ANISTOCK_GAME_DB=/path/to/game.db
