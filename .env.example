# copy to .env and fill in; .env is git-ignored
ANNICT_TOKEN=

# overseas sources (AniList, Annict) go through the proxy; Bangumi goes direct
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890
NO_PROXY=localhost,127.0.0.1,api.bgm.tv,bgm.tv

# optional
# ANISTOCK_DB=/path/to/anistock.db   # default: data/anistock.db next to collect.py
# ANNICT_EXTRA_IDS=          # comma-separated Annict work ids for long-running shows (One Piece, Conan...)
# UV_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple   # if PyPI is slow
