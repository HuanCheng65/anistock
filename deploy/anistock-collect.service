[Unit]
Description=AniStock daily data collector

[Service]
Type=oneshot
# %h = your home directory; assumes the repo is cloned to ~/anistock
WorkingDirectory=%h/anistock
EnvironmentFile=%h/anistock/.env
# systemd does not use your shell PATH; `which uv` and put the full path here if it differs
ExecStart=%h/.local/bin/uv run %h/anistock/collect.py
TimeoutStartSec=1h
