[Unit]
Description=AniEx hourly episode-comment snapshot (热度快讯 data)

[Service]
Type=oneshot
WorkingDirectory=%h/anistock
EnvironmentFile=%h/anistock/.env
# Record-only for now: observations go to data/flash-log/, which the game server does not read.
# v0.3.0 switches --inbox to data/events/inbox so the server turns them into 热度快讯.
ExecStart=%h/anistock/.venv/bin/python %h/anistock/engine/flash_fetch.py --inbox %h/anistock/data/flash-log
TimeoutStartSec=10min
