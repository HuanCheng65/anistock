[Unit]
Description=Run AniStock collector daily

[Timer]
# late-night anime airs ~23:00-02:00 China time; collect after the night's episodes
OnCalendar=*-*-* 06:00:00 Asia/Shanghai
# if the server was off at 06:00, run as soon as it is back
Persistent=true
RandomizedDelaySec=5min

[Install]
WantedBy=timers.target
