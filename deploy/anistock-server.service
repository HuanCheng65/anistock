[Unit]
Description=AniStock game server
After=network-online.target

[Service]
# %h = your home directory; assumes the repo is cloned to ~/anistock
WorkingDirectory=%h/anistock
# defaults; ANISTOCK_HOST / ANISTOCK_PORT in .env override them (EnvironmentFile is read after Environment)
Environment=ANISTOCK_HOST=127.0.0.1
Environment=ANISTOCK_PORT=18620
EnvironmentFile=%h/anistock/.env
# behind a reverse proxy on the same machine: trust its X-Forwarded-For / X-Forwarded-Proto
ExecStart=%h/.local/bin/uv run uvicorn server.app:app --host ${ANISTOCK_HOST} --port ${ANISTOCK_PORT} --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
