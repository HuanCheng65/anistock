[Unit]
Description=AniStock game server (v2)
After=network-online.target

[Service]
# %h = your home directory; assumes the repo is cloned to ~/anistock. deploy/update.sh downloads the
# binary from the GitHub release into bin/; the Python venv is still used by the daily close (engine/
# daily_inputs.py) and the collector.
WorkingDirectory=%h/anistock
# defaults; ANISTOCK_HOST / ANISTOCK_PORT in .env override them (EnvironmentFile is read after Environment)
Environment=ANISTOCK_HOST=127.0.0.1
Environment=ANISTOCK_PORT=18620
Environment=ANISTOCK_ROOT=%h/anistock
EnvironmentFile=%h/anistock/.env
ExecStart=%h/anistock/bin/anistock
# SIGTERM: stop accepting requests, write everything to the database, exit
KillSignal=SIGTERM
TimeoutStopSec=30
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
