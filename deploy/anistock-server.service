[Unit]
Description=AniStock game server
After=network-online.target

[Service]
# %h = your home directory; assumes the repo is cloned to ~/anistock
WorkingDirectory=%h/anistock
EnvironmentFile=%h/anistock/.env
# build the frontend (web/dist) before the first start: the server serves it if it exists at startup
ExecStart=%h/.local/bin/uv run uvicorn server.app:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
